@model CrossTrainingPlatform.Models.Domain

<div class="page-wrapper">
    <div class="domain-container">
        <h2>Select Domain</h2>

        <form method="post" asp-action="DisplayGamesBasedOnDomain" asp-controller="Games">
            <div class="form-group">
                <label>Select Domain:</label>
                <select asp-for="DomainId" asp-items="@(new SelectList(ViewBag.DomainList, "DomainId", "DomainName"))">
                    <option value="">-- Select Domain --</option>
                </select>
            </div>

            <button type="submit" class="submit-btn">Submit</button>
        </form>
    </div>
</div>



