<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CrossTrainingPlatform</title>

    <link rel="stylesheet" href="~/css/offlineBootstrap1-11-3.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CrossTrainingPlatform.styles.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/bootstrap-icons-1.11.3/font/bootstrap-icons.css" asp-append-version="true" />
    <link rel="stylesheet" type="text/css" href="~/css/toastify.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-glass mb-3 position-relative">
            <div class="container-fluid d-flex justify-content-center align-items-center position-relative">


                @{
                    var userId = Context.Session.GetInt32("UserId"); // sau User.Identity.IsAuthenticated
                }

                @if (userId != null)
                {
                    <!-- Hamburger menu stanga -->
                    <button id="sidebarToggle" class="hamburger-btn me-3" aria-label="Toggle sidebar">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                }

                <!-- Brand central -->
                <a class="navbar-brand site-title">
                    Cross Training Platform
                </a>

                <!-- Info button -->
                <a asp-area="" asp-controller="Home" asp-action="Index" class="info-btn" >
                    <i class="bi bi-info-circle-fill"></i>
                </a>

            </div>
        </nav>
    </header>


    <!-- Sidebar -->
    <div id="sidebar" class="sidebar">
        <button id="closeSidebar" class="close-btn">✕</button>
        <ul>
            <li><a href="@Url.Action("Index", "Profile")">Profile</a></li>
            <li>
                <a href="@Url.Action("DisplayGamesBasedOnDomain", "Games")">Games</a>
            </li>

            <li class="has-submenu">
                <a href="#" id="adminToggle" class="admin-toggle">
                    Admin Settings <span class="arrow">&#9662;</span>
                </a>

                <ul id="adminSubmenu" class="submenu">
                    <li><a href="/Admin/AppRoles">AppRoles</a></li>
                    <li><a href="/Admin/AppClaims">AppClaims</a></li>
                    <li><a href="/Admin/AppUsers">AppUsers</a></li>
                    <li><a href="/Admin/Domains">Domains</a></li>
                </ul>
            </li>

        </ul>
    </div>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script type="text/javascript" src="~/js/taostify.js" type="text/javascript"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        const sidebarToggle = document.getElementById('sidebarToggle');
        const sidebar = document.getElementById('sidebar');
        const closeSidebar = document.getElementById('closeSidebar');

        sidebarToggle.addEventListener('click', () => {
            sidebar.classList.add('active'); // deschide sidebar
        });

        closeSidebar.addEventListener('click', () => {
            sidebar.classList.remove('active'); // închide sidebar
        });


        document.addEventListener("DOMContentLoaded", function () {
            const toggle = document.getElementById("adminToggle");
            const submenu = document.getElementById("adminSubmenu");

            toggle.addEventListener("click", function(e) {
                e.preventDefault();
                submenu.classList.toggle("open");
            });
        });

    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

