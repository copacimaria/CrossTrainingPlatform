@model CrossTrainingPlatform.Models.Game
@Html.AntiForgeryToken()

<div class="delete-modal-container">

    <h3 class="delete-title">Confirmare stergere</h3>

    <p class="delete-warning">
        Esti sigur ca vrei sa stergi acest joc?
    </p>

    <div class="delete-summary">
        <p><strong>Nume joc:</strong> @Model.GameName</p>
    </div>

    <input type="hidden" id="deleteGameId" value="@Model.GameId" />

    <br />

    <div class="d-flex justify-content-center">
        <button class="btn btn-danger" onclick="deleteGame()">Confirma stergerea</button>
    </div>

</div>

