@model CrossTrainingPlatform.Models.ViewModels.GamesViewModel

@{
    ViewData["Title"] = "Games";
}

<h2 style="margin:20px; color:white;">Available Games</h2>

<div class="games-grid">

    @foreach (var game in Model.AllGames)
    {
        if (game.IsActive == true)
        {

            bool isInSelected = Model.GamesForSelectedDomain
            .Any(g => g.GameId == game.GameId);

            <div class="game-card flip-card" data-expanded="false">

                <div class="flip-card-inner">

                        <!-- FRONT -->
                        <div class="flip-card-front">

                            <!-- DOWNLOAD BUTTON -->
                            @if (!string.IsNullOrEmpty(game.DownloadLink))
                            {
                                <a href="@game.DownloadLink" target="_blank" class="download-btn">
                                    <i class="bi bi-download"></i>
                                </a>
                            }

                            <div class="game-name">@game.GameName</div>

                    <div class="game-body">

                                @if (game.Domain != null)
                                {
                                    <p><strong>Domain:</strong> @game.Domain.DomainName</p>
                                }
                                else
                                {
                                    <p><strong>Domain:</strong> Not assigned</p>
                                }
                    </div>




                </div>



                    <!-- BACK -->
                      <div class="flip-card-back">
                        <p class="game-description">
                            @(string.IsNullOrEmpty(game.Description)
                                                ? "Fara descriere."
                                                : (game.Description.Length > 300
                                                ? game.Description.Substring(0, 300) + "..."
                                                : game.Description))
                        </p>
                      </div>


                </div>


              @if (isInSelected)
                {
                    <div class="suitable">
                        <span>Suitable for your selection ✔</span>
                    </div>
                }

            </div>


        }

        
    }

</div>


<script>

      document.querySelectorAll('.flip-card').forEach(card => {
        const suitableEl = card.querySelector('.suitable'); // elementul de front

        card.addEventListener('click', function () {
           
            this.classList.toggle('flipped');

            const isExpanded = this.getAttribute('data-expanded') === 'true';

            if (isExpanded) {
                this.style.transform = 'scale(1)';
                this.style.zIndex = '1';
                this.setAttribute('data-expanded', 'false');

                if (suitableEl) suitableEl.style.display = 'block'; 
            } else {
                this.style.transform = 'scale(1.6)';
                this.style.zIndex = '1000'; 
                this.setAttribute('data-expanded', 'true');

                if (suitableEl) suitableEl.style.display = 'none'; 
            }
        });
    });


</script>


