@model IEnumerable<CrossTrainingPlatform.Models.Game>

@{
    ViewData["Title"] = "Games";
}

<h2 style="margin-bottom:20px;">Available Games</h2>

<div class="games-grid">
    @foreach (var game in Model)
    {
        <div class="game-card">
            <div class="game-name">@game.GameName</div>

            <div class="game-body">
                <p><strong>Active:</strong> @(game.IsActive ? "Yes" : "No")</p>

                @if (game.Domain != null)
                {
                    <p><strong>Domain:</strong> @game.Domain.DomainName</p>
                }
                else
                {
                    <p><strong>Domain:</strong> Not assigned</p>
                }
            </div>

            <div class="suitable">
                <span>Suitable for you ✔</span>
            </div>
        </div>
    }
</div>

<style>
    .games-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 20px;
    }

    .game-card {
        border: 1px solid #ccc;
        padding: 15px;
        border-radius: 10px;
        background: white;
        box-shadow: 0 3px 6px rgba(0,0,0,0.1);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .game-name {
        font-size: 20px;
        font-weight: bold;
        text-align: center;
        margin-bottom: 15px;
    }

    .game-body {
        margin-bottom: 15px;
        font-size: 14px;
    }

    .suitable {
        margin-top: auto;
        text-align: center;
        padding: 10px;
        background: #e3ffe3;
        border-radius: 8px;
        font-weight: bold;
        color: #1b7d1b;
        border: 1px solid #9cdb9c;
    }
</style>
