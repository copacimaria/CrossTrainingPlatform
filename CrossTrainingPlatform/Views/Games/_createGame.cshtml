@model CrossTrainingPlatform.Models.Game
@Html.AntiForgeryToken()

<div class="row justify-content-center">
    <div class="col-sm-8">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="modal-form-group mb-3">
            <label asp-for="GameName" style="font-size: 25px;" class="control-label fw-bold">Nume joc:</label>
            <input asp-for="GameName" id="gameNameCreate" class="form-control" />
        </div>

        <div class="modal-form-group mb-3">
            <label asp-for="DomainId" style="font-size: 25px;" class="control-label fw-bold">Domain:</label>
            <select asp-for="DomainId" class="form-control" id="domainCreate" asp-items="ViewBag.Domains">
                <option value="">-- Selecteaza domeniul --</option>
            </select>
        </div>

        <div class="modal-form-group mb-3">
            <label asp-for="DownloadLink" style="font-size: 25px;" class="control-label fw-bold">Link de descarcare:</label>
            <input asp-for="DownloadLink" id="linkCreate" class="form-control" />
        </div>

        <div class="modal-form-group mb-3">
            <label asp-for="Description" style="font-size: 25px;" class="control-label fw-bold">Descriere:</label>
            <textarea asp-for="Description" id="descriptionCreate" class="form-control" maxlength="300" rows="3" style="resize:none;"></textarea>
        </div>

        <br />

        <div class="d-flex justify-content-center">
            <button type="button" onclick="createGame()" class="btn btn-success">Adauga</button>
        </div>
    </div>
</div>