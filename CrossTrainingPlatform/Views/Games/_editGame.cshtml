@model CrossTrainingPlatform.Models.Game
@Html.AntiForgeryToken()

<div class="modal-form-group mb-3">
    <label asp-for="GameName" class="control-label fw-bold">Nume joc:</label>
    <input asp-for="GameName" class="form-control custom-input" />
</div>

<div class="modal-form-group mb-3">
    <label asp-for="DomainId" style="font-size: 25px;" class="control-label fw-bold">Domain:</label>
    <select asp-for="DomainId" class="form-control" id="domainEdit" asp-items="ViewBag.Domains">
        <option value="">-- Selecteaza domeniul --</option>
    </select>
</div>

<div class="modal-form-group mb-3">
    <label asp-for="Description" class="control-label fw-bold">Descriere:</label>
    <textarea asp-for="Description" id="descriptionEdit" class="form-control custom-input" maxlength="300" rows="3" style="resize:none;"></textarea>
</div>

<div class="modal-form-group mb-3">
    <label asp-for="DownloadLink" class="control-label fw-bold">Link download:</label>
    <input asp-for="DownloadLink" class="form-control custom-input" />
</div>

<div class="text-end">
    <button class="btn btn-primary" onclick="submitEditGame(@Model.GameId)">Salveaza</button>
</div>
