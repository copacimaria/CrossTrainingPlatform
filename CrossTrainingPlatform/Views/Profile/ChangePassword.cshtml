@model CrossTrainingPlatform.Models.ViewModels.ChangePasswordVM


<div class="form-container" style="max-width:400px;">

    <h2 style="color:white;">Change Password</h2>



    @if (ViewBag.Success != null)
    {
        <div style="color:lime; margin-bottom:15px;">
            @ViewBag.Success
        </div>
    }

    <form method="post">

        <div class="form-group">
            <label style="color:white;">Old Password</label>
            <input type="password" asp-for="OldPassword" class="form-control" style="color:white; background:#222;">
            <span asp-validation-for="OldPassword" style="color:red;"></span>
        </div>

        <div class="form-group">
            <label style="color:white;">New Password</label>
            <input type="password" asp-for="NewPassword" class="form-control" style="color:white; background:#222;">
            <span asp-validation-for="NewPassword" style="color:red;"></span>
        </div>

        <button type="submit" class="btn btn-primary" style="margin-top:10px;">Save</button>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
