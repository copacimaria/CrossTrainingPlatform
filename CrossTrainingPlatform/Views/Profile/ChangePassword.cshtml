@model CrossTrainingPlatform.Models.ViewModels.ChangePasswordVM

<div class="page-wrapper">
    <div class="login-container" style="max-width:400px;">
        <h2 style="color:white; text-align:center;">Change Password</h2>

        @if (ViewBag.Success != null)
        {
            <div style="color:lime; margin-bottom:15px; text-align:center;">
                @ViewBag.Success
            </div>
            <div style="text-align:center; margin-top:10px;">
                <a href="/Profile/Index" style="color:cadetblue; text-decoration:underline; font-weight:bold;">Inapoi la profil</a>
            </div>

        }

        <form method="post">

            <div class="form-group">
                <label style="color:white;">Old Password</label>
                <input asp-for="OldPassword" type="password" class="form-control" style="color:white; background:#222;">
                <span asp-validation-for="OldPassword" style="color:red;"></span>
            </div>

            <div class="form-group">
                <label style="color:white;">New Password</label>
                <input asp-for="NewPassword" type="password" class="form-control" style="color:white; background:#222;">
                <span asp-validation-for="NewPassword" style="color:red;"></span>
            </div>

            <button type="submit" class="login-btn" style="width:100%; margin-top:10px;">Save</button>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
