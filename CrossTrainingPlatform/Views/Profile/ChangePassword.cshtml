@model CrossTrainingPlatform.Models.ViewModels.ChangePasswordVM

<div class="page-wrapper">
    <div class="form-container">
        <h2 style="color:white;">Change Password</h2>

        @if (ViewBag.Success != null)
        {
            <p style="color: green; font-weight: bold;">@ViewBag.Success</p>
        }

        <form method="post">
            <div class="form-group">
                <label>Old Password</label>
                <input type="password" asp-for="OldPassword" class="form-control" />
                <span asp-validation-for="OldPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>New Password</label>
                <input type="password" asp-for="NewPassword" class="form-control" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="submit-btn">Save</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
