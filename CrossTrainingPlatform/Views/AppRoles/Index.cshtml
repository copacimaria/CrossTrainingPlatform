@model X.PagedList.IPagedList<CrossTrainingPlatform.Models.UserManagementModels.AppRole>
@using X.PagedList.Mvc.Core



<br />
<br />


<!-- Modale -->
<div class="modal fade" id="createRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog" style="width:40rem">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Creare rol:</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="contentAddRole"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="editRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog" style="width:40rem">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editeaza rol:</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="contentEditRole"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog" style="width:40rem">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmare stergere rol:</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="contentDeleteRole"></div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center" style="padding:0.5rem; margin-right:1rem;">
    <h1 class="mb-0" style="color:white;">Roluri</h1>
    @* @if  (User.HasClaim(c => c.Value == "CreateRoles"))
    { *@
        <button onclick="loadCreateRole()"
                data-bs-toggle="modal"
                data-bs-target="#createRoleModal"
                class="btn btn-dark fw-bold">
            <i class="bi bi-plus-circle me-2"></i>
            Creeaza un rol nou
            </button>
    @* } *@
</div>



<div class="col" style="color:white;">

    <!-- Filtre -->
    <div class="d-flex mb-3">
        <form method="get" class="d-flex gap-3" style="margin-left:0.5rem; margin-right:1rem">
            <div>
                <label for="RoleSearch" class="form-label mb-0" style="font-size: 1rem; font-weight:bold; color:white;">
                    Cauta rolul:
                </label>
                <input type="text" id="RoleSearch" name="RoleSearch" placeholder="Cauta dupa nume"
                       class="form-control form-control-sm" style="width:12.5rem; color:black;"
                       value="@(!string.IsNullOrEmpty(ViewBag.SelectedRole) ? ViewBag.SelectedRole : "")">
            </div>
            <button type="button" class="btn btn-success mt-4" style="font-weight:bold">
                <i class="bi bi-search"></i> Filtreaza
            </button>
            <button type="button" class="btn btn-danger mt-4" style="font-weight:bold">
                <i class="bi bi-x-circle"></i> Reseteaza
            </button>
        </form>
    </div>

    <table class="table table-hover" style="color:white;">
        <thead>
            <tr>
                <th style="font-weight:bold">Nume rol</th>
                <th style="font-weight:bold">Drepturi din rol</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(m => item.RoleName)</td>

                        <td>
                            <a asp-controller="AppRoles" asp-action="Details" asp-route-id="@item.RoleId"
                               class="btn btn-info btn-sm" style="color:red; font-weight:bold">
                                <i class="bi bi-plus-circle" style="font-weight:bold"></i> Drepturi
                            </a>
                        </td>

                        <td>
                            <button data-bs-toggle="modal" data-bs-target="#editRoleModal"
                                    onclick="loadEditRole(@item.RoleId)" class="edit-link">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button data-bs-toggle="modal" data-bs-target="#deleteRoleModal"
                                    onclick="loadDeleteRole(@item.RoleId)" class="delete-link">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </td>

                    </tr>
                }
            }
        </tbody>
    </table>

    <!-- Paginare -->
    <div class="pagination-container d-flex justify-content-center mb-5">
        @Html.PagedListPager(Model, page =>
        Url.Action("Index", "AppRoles", new
        {
            page,
            RoleSearch = ViewBag.SelectedRole
        })
                )
    </div>
</div>


<script>
    function resetFilters() {
        document.getElementById('RoleSearch').value = '';
        window.location.href = `/AppRoles/Index`;
    }

    function searchRole() {
        const Role = document.getElementById('RoleSearch').value;
        const url = `/AppRoles/Index?RoleSearch=${encodeURIComponent(Role)}&applyFilter=true`;
        window.location.href = url;
    }

  
    function loadCreateRole() {
        fetch('@Url.Action("Create", "AppRoles")')
            .then(response => response.text())
            .then(html => {
                 const container = document.getElementById('contentAddRole');
                if (!container) {
                    console.error('Container modal nu exista!');
                    return;
                }

                container.innerHTML = html;

                  const modalEl = document.getElementById('createRoleModal');
                if (!modalEl) {
                    console.error('Modal element nu exista!');
                    return;
                }

                const modal = new bootstrap.Modal(modalEl, { backdrop: true });
                modal.show();

            })
            .catch(err => console.error(err));
    }

    async function createRole() {

        var roleName = document.getElementById('roleNameCreate').value
        if (!roleName) {
            alert('Completati toate datele!');
            return;
        }

        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';

        const response = await fetch('/AppRoles/Create', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: `RoleName=${encodeURIComponent(roleName)}`
        });

        const text = await response.text();
        let result;
        try {
            result = JSON.parse(text);
        } catch (e) {
            console.error('Raspunsul nu este JSON, este:', text);
            return;
        }

        if (result.success) {
            sessionStorage.setItem('showToastRoleCreated', 'true');
            location.reload();
        } else {
            alert(result.errors ? result.errors.join("\n") : 'Eroare necunoscuta');
        }
    }

    function loadEditRole(id) {
        fetch(`@Url.Action("Edit", "AppRoles")/${id}`)
            .then(response => response.text())
            .then(html => {
                 const container = document.getElementById('contentEditRole');
                if (!container) {
                    console.error('Container modal nu exista!');
                    return;
                }

                container.innerHTML = html;

                  const modalEl = document.getElementById('editRoleModal');
                if (!modalEl) {
                    console.error('Modal element nu exista!');
                    return;
                }

                const modal = new bootstrap.Modal(modalEl, { backdrop: true });
                modal.show();

            })
            .catch(err => console.error(err));
    }

    async function saveEditRole (roleId) {

        var roleNameEdit = document.getElementById('roleNameEdit').value

        if (!roleNameEdit) {
            alert('Completati datele!');
            return;
        }

        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';

        const response = await fetch('/AppRoles/Edit', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: `id=${encodeURIComponent(roleId)}&RoleName=${encodeURIComponent(roleNameEdit)}`
        });

        const text = await response.text();
        let result;
        try {
            result = JSON.parse(text);
        } catch (e) {
            console.error('Raspunsul nu este JSON, este:', text);
            return;
        }

        if (result.success) {
            sessionStorage.setItem('showToastRoleEdited', 'true');
            location.reload();
        } else {
            alert(result.errors ? result.errors.join("\n") : 'Eroare necunoscuta');
        }
    }



    function loadDeleteRole(id) {
        fetch(`@Url.Action("Delete", "AppRoles")/${id}`)
            .then(response => response.text())
            .then(html => {
                 const container = document.getElementById('contentDeleteRole');
                if (!container) {
                    console.error('Container modal nu exista!');
                    return;
                }

                container.innerHTML = html;

                  const modalEl = document.getElementById('deleteRoleModal');
                if (!modalEl) {
                    console.error('Modal element nu exista!');
                    return;
                }

                const modal = new bootstrap.Modal(modalEl, { backdrop: true });
                modal.show();

            })
            .catch(err => console.error(err));
    }

    async function postDeleteRole(roleId) {

        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';

        const response = await fetch('/AppRoles/DeleteConfirmed', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: `id=${encodeURIComponent(roleId)}`
        });

        const text = await response.text();
        let result;
        try {
            result = JSON.parse(text);
        } catch (e) {
            console.error('Raspunsul nu este JSON, este:', text);
            return;
        }

        if (result.success) {
            sessionStorage.setItem('showToastRoleDeleted', 'true');
            location.reload();
        } else {
            alert(result.errors ? result.errors.join("\n") : 'Eroare necunoscuta');
        }
    }



    window.onload = function() {
        if(sessionStorage.getItem('showToastRoleCreated') === 'true') {
            Toastify({
                text: "Rolul a fost creat!",
                duration: 3000,
                close: true,
                gravity: "bottom",
                position: "center",
                style: { background: "grey" },
            }).showToast();
            sessionStorage.removeItem('showToastRoleCreated');
        }

        if(sessionStorage.getItem('showToastRoleEdited') === 'true') {
            Toastify({
                text: "Rolul a fost editat!",
                duration: 3000,
                close: true,
                gravity: "bottom",
                position: "center",
                style: { background: "green" },
            }).showToast();
            sessionStorage.removeItem('showToastRoleEdited');
        }

        if(sessionStorage.getItem('showToastRoleDeleted') === 'true') {
            Toastify({
                text: "Rolul a fost sters!",
                duration: 3000,
                close: true,
                gravity: "bottom",
                position: "center",
                style: { background: "red" },
            }).showToast();
            sessionStorage.removeItem('showToastRoleDeleted');
        }
    }


     //daca raname backdropul din modal
    document.addEventListener('hidden.bs.modal', function (event) {
        // elimină backdrop-ul dacă mai rămâne
        document.querySelectorAll('.modal-backdrop').forEach(function (el) {
            el.remove();
        });
        // elimină clasa modal-open din body
        document.body.classList.remove('modal-open');
        document.body.style.removeProperty('padding-right');
    });


</script>
