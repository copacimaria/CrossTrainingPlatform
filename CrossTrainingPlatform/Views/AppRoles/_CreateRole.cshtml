@model CrossTrainingPlatform.Models.UserManagementModels.AppRole
@Html.AntiForgeryToken()


<div class="row justify-content-center">
    <div class="col-sm-8">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="modal-form-group mb-3">

            <label asp-for="RoleName" style="font-size: 25px;" class="control-label fw-bold">Nume rol:</label>
            <input asp-for="RoleName" id="roleNameCreate" class="form-control" />

        </div>

        <br />

        <div class="d-flex justify-content-center">
            <button type="button" onclick="createRole()" class="btn btn-success" />
            Adauga
        </div>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
