@using X.PagedList.Mvc.Core
@model X.PagedList.IPagedList<CrossTrainingPlatform.Models.UserManagementModels.AppClaim>

@{
    ViewData["Title"] = "Index";
}

<br />
<br />


<!-- Modale -->
<div class="modal fade" id="createClaimModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog" style="width:40rem">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Creare claim:</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="contentAddClaim"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="editClaimModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog" style="width:40rem">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editeaza claim-ul:</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="contentEditClaim"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteClaimModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog" style="width:40rem">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmare stergere claim</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="contentDeleteClaim"></div>
        </div>
    </div>
</div>


<div class="modal fade" id="detailsClaimModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog" style="width:40rem">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Detalii claim</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="contentDetailsClaim"></div>
        </div>
    </div>
</div>


@if (User.HasClaim(c => c.Value == "CreateClaim"))
{
    <div class="d-flex justify-content-between align-items-center" style="padding:0.5rem; margin-right:1rem;">
        <h1 class="mb-0">Claim-uri</h1>
        <button onclick="loadCreateClaim()"
                data-bs-toggle="modal"
                data-bs-target="#createClaimModal"
                class="btn btn-dark fw-bold">
            <i class="bi bi-plus-circle me-2"></i>
            Creeaza un nou claim
        </button>
        </div>
}



<div class="col">

    <!-- Filtre -->
    <div class="d-flex mb-3">
        <form method="get" class="d-flex gap-3" style="margin-left:0.5rem; margin-right:1rem">
            <div>
                <label for="claimSearch" class="form-label mb-0" style="font-size: 1rem; font-weight:bold">
                    Cauta un claim:
                </label>
                <input type="text" id="claimSearch" name="claimSearch" placeholder="Cauta dupa nume"
                       class="form-control form-control-sm" style="width:12.5rem"
                       value="@(!string.IsNullOrEmpty(ViewBag.SelectedClaim) ? ViewBag.SelectedClaim : "")">
            </div>
            <button type="button" class="btn btn-success mt-4" style="font-weight:bold" onclick="searchClaim()">
                <i class="bi bi-search"></i> Filtreaza
            </button>
            <button type="button" class="btn btn-danger mt-4" style="font-weight:bold" onclick="resetFilters()">
                <i class="bi bi-x-circle"></i> Reseteaza
            </button>
        </form>
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th style="font-weight:bold">Nume claim</th>
                <th></th>

            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(m => item.ClaimName)</td>

                        <td>
                            @if (User.HasClaim(c => c.Value == "ViewClaim"))
                            {
                                <button data-bs-toggle="modal" data-bs-target="#detailsClaimModal"
                                        onclick="viewRolesInClaim(@item.ClaimId)" class="view-link">
                                    <i class="bi bi-eye-fill"></i>
                                </button>
                            }
                            @if (User.HasClaim(c => c.Value == "EditClaim"))
                            {
                                <button data-bs-toggle="modal" data-bs-target="#editClaimModal"
                                        onclick="loadEditClaim(@item.ClaimId)" class="edit-link">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                            }
                            @if (User.HasClaim(c => c.Value == "DeleteClaim"))
                            {
                                <button data-bs-toggle="modal" data-bs-target="#deleteClaimModal"
                                        onclick="loadDeleteClaim(@item.ClaimId)" class="delete-link">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            }
                        </td>

                    </tr>
                }
            }
        </tbody>
    </table>

    <!-- Paginare -->
    <div class="pagination-container d-flex justify-content-center mb-5">
        @Html.PagedListPager(Model, page =>
        Url.Action("Index", "AppClaims", new
        {
            page,
            claimSearch = ViewBag.SelectedClaim
        })
                )
    </div>
</div>



<script>

    function resetFilters() {
        document.getElementById('claimSearch').value = '';
        window.location.href = `/AppClaims/Index`;
    }

    function searchClaim() {
        const claim = document.getElementById('claimSearch').value;
        const url = `/AppClaims/Index?claimSearch=${encodeURIComponent(claim)}&applyFilter=true`;
        window.location.href = url;
    }



    function viewRolesInClaim(id) {
        fetch(`@Url.Action("Details", "AppClaims")/${id}`)
            .then(response => response.text())
            .then(html => {
                 const container = document.getElementById('contentDetailsClaim');
                if (!container) {
                    console.error('Container modal nu exista!');
                    return;
                }

                container.innerHTML = html;

                  const modalEl = document.getElementById('detailsClaimModal');
                if (!modalEl) {
                    console.error('Modal element nu exista!');
                    return;
                }

                const modal = new bootstrap.Modal(modalEl, { backdrop: true });
                modal.show();

            })
            .catch(err => console.error(err));
    }


    function loadCreateClaim() {
        fetch(`@Url.Action("Create", "AppClaims")`)
            .then(response => response.text())
            .then(html => {
                const container = document.getElementById('contentAddClaim');
                if (!container) {
                    console.error('Container modal nu exista!');
                    return;
                }
                container.innerHTML = html;
                const modalEl = document.getElementById('createClaimModal');
                if (!modalEl) {
                    console.error('Modal element nu exista!');
                    return;
                }
                const modal = new bootstrap.Modal(modalEl, { backdrop: true });
                modal.show();
            })
            .catch(err => console.error(err));
    }

    async function createClaim() {

        var claimName = document.getElementById('claimNameCreate').value;

        if (!claimName) {
            alert('Completati toate datele!');
            return;
        }

        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';

        const response = await fetch('/AppClaims/Create', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
              body: `ClaimName=${encodeURIComponent(claimName)}`
        });

        const text = await response.text();
        let result;
        try {
            result = JSON.parse(text);
        } catch (e) {
            console.error('Raspunsul nu este JSON, este:', text);
            return;
        }

        if (result.success) {
            sessionStorage.setItem('showToastClaimCreated', 'true');
            location.reload();
        } else {
            alert(result.errors ? result.errors.join("\n") : 'Eroare necunoscuta');
        }
    }


    function loadEditClaim(id) {
        fetch(`@Url.Action("Edit", "AppClaims")/${id}`)
            .then(response => response.text())
            .then(html => {
                const container = document.getElementById('contentEditClaim');
                if (!container) {
                    console.error('Container modal nu exista!');
                    return;
                }
                container.innerHTML = html;
                const modalEl = document.getElementById('editClaimModal');
                if (!modalEl) {
                    console.error('Modal element nu exista!');
                    return;
                }
                const modal = new bootstrap.Modal(modalEl, { backdrop: true });
                modal.show();
            })
            .catch(err => console.error(err));
    }



    async function editClaim(claimId) {

        var claimName = document.getElementById('claimNameEdit').value;

        if (!claimName) {
            alert('Completati toate datele!');
            return;
        }

        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';

        const response = await fetch('/AppClaims/Edit', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
             body: `id=${encodeURIComponent(claimId)}&ClaimName=${encodeURIComponent(claimName)}`
        });

        const text = await response.text();
        let result;
        try {
            result = JSON.parse(text);
        } catch (e) {
            console.error('Raspunsul nu este JSON, este:', text);
            return;
        }

        if (result.success) {
            sessionStorage.setItem('showToastClaimEdited', 'true');
            location.reload();
        } else {
            alert(result.errors ? result.errors.join("\n") : 'Eroare necunoscuta');
        }
    }



    async function postDeleteClaim(claimId) {

        const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
        const token = tokenInput ? tokenInput.value : '';

        const response = await fetch('/AppClaims/DeleteConfirmed', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'RequestVerificationToken': token
            },
            body: `id=${encodeURIComponent(claimId)}`
        });

        const text = await response.text();
        let result;
        try {
            result = JSON.parse(text);
        } catch (e) {
            console.error('Raspunsul nu este JSON, este:', text);
            return;
        }

        if (result.success) {
            sessionStorage.setItem('showToastClaimDeleted', 'true');
            location.reload();
        } else {
            alert(result.errors ? result.errors.join("\n") : 'Eroare necunoscuta');
        }
    }




    function loadDeleteClaim(id) {
        fetch(`@Url.Action("Delete", "AppClaims")/${id}`)
            .then(response => response.text())
            .then(html => {
                const container = document.getElementById('contentDeleteClaim');
                if (!container) {
                    console.error('Container modal nu exista!');
                    return;
                }
                container.innerHTML = html;
                const modalEl = document.getElementById('deleteClaimModal');
                if (!modalEl) {
                    console.error('Modal element nu exista!');
                    return;
                }
                const modal = new bootstrap.Modal(modalEl, { backdrop: true });
                modal.show();
            })
            .catch(err => console.error(err));
    }









     window.onload = function() {
        if(sessionStorage.getItem('showToastClaimCreated') === 'true') {
            Toastify({
                text: "Claim-ul a fost creat!",
                duration: 3000,
                close: true,
                gravity: "bottom",
                position: "center",
                style: { background: "grey" },
            }).showToast();
            sessionStorage.removeItem('showToastClaimCreated');
        }

        

        if(sessionStorage.getItem('showToastClaimEdited') === 'true') {
            Toastify({
                text: "Claim-ul a fost editat!",
                duration: 3000,
                close: true,
                gravity: "bottom",
                position: "center",
                style: { background: "green" },
            }).showToast();
            sessionStorage.removeItem('showToastClaimEdited');
        }
        
        if(sessionStorage.getItem('showToastClaimDeleted') === 'true') {
            Toastify({
                text: "Claim-ul a fost sters!",
                duration: 3000,
                close: true,
                gravity: "bottom",
                position: "center",
                style: { background: "red" },
            }).showToast();
            sessionStorage.removeItem('showToastClaimDeleted');
        }
     }




     //daca raname backdropul din modal
    document.addEventListener('hidden.bs.modal', function (event) {
        // elimină backdrop-ul dacă mai rămâne
        document.querySelectorAll('.modal-backdrop').forEach(function (el) {
            el.remove();
        });
        // elimină clasa modal-open din body
        document.body.classList.remove('modal-open');
        document.body.style.removeProperty('padding-right');
    });


</script>