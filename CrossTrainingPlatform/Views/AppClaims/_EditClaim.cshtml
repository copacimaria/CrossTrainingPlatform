@model CrossTrainingPlatform.Models.UserManagementModels.AppClaim
@Html.AntiForgeryToken()




<div class="row justify-content-center">
    <div class="col-sm-8">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="ClaimId" />

        <div class="modal-form-group mb-3">
            <label asp-for="ClaimName" class="control-label">Numele claim-ului:</label>
            <input asp-for="ClaimName" id="claimNameEdit" class="form-control" />
            <span asp-validation-for="ClaimName" class="text-danger"></span>
        </div>


        <br />

        <div class="d-flex justify-content-center">
            <button type="button" onclick="editClaim('@Model.ClaimId')" class="btn btn-success" />
            Salveaza
        </div>
    
    </div>
</div>  


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
