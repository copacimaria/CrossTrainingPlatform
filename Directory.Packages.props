<Project>

  <!--
    Central Package Management: versiunile pachetelor NuGet se declara o singura
    data, aici. In .csproj se scrie doar <PackageReference Include="..." />,
    fara Version. Elimina riscul ca doua proiecte sa foloseasca versiuni diferite
    din acelasi pachet.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Microsoft.Extensions">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="EF Core">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Cazuri de utilizare">
    <!--
      MediatR 12.x este Apache 2.0. Incepand cu versiunea 13, proiectul a trecut la
      licenta comerciala, la fel ca FluentAssertions 8. Versiunea este fixata
      intentionat; o urcare la 13 este o decizie de licentiere, nu una tehnica.
      Vezi ADR-0008.
    -->
    <PackageVersion Include="MediatR" Version="12.4.1" />
    <!--
      FluentValidation a fost scos (ADR-0010): invariantii stau in entitati, iar
      validatoarele de comanda ii repetau.
    -->
  </ItemGroup>

  <ItemGroup Label="Securitate">
    <PackageVersion Include="Isopoh.Cryptography.Argon2" Version="2.0.0" />
    <!--
      Dependinta tranzitiva a Microsoft.Data.SqlClient, care ar aduce 9.0.11 - versiune cu
      doua vulnerabilitati cunoscute de tip denial of service (CVE-2026-84008, severitate
      mare, si CVE-2026-70162), reparate in 10.0.13. Fixata aici prin
      CentralPackageTransitivePinningEnabled; auditul NuGet opreste build-ul altfel.
      De scos cand SqlClient aduce singur o versiune reparata.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="X.PagedList" Version="10.5.7" />
    <PackageVersion Include="X.PagedList.Mvc.Core" Version="10.5.7" />
  </ItemGroup>

  <ItemGroup Label="Operare">
    <!-- Serilog: Apache 2.0. Logging structurat si un rand de log per cerere HTTP. -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- Verificarea bazei de date pentru /health/ready. Aceeasi versiune ca EF Core. -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.13" />
  </ItemGroup>


  <ItemGroup Label="Testare">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.2" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <!--
      Shouldly, nu FluentAssertions: incepand cu versiunea 8, FluentAssertions cere
      licenta platita pentru uz comercial. Shouldly este Apache 2.0.
    -->
    <PackageVersion Include="Shouldly" Version="4.2.1" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.23" />
    <!--
      Folosit direct de SqlServerFixture, dar fixat central si pentru EF Core: versiunea
      trebuie sa fie exact cea ceruta de Microsoft.EntityFrameworkCore.SqlServer (6.1.7 pentru
      EF Core 10.0.13). O versiune mai mica e refuzata la restore (NU1109); o versiune majora
      noua ar trece EF pe un driver cu care nu a fost testat.
    -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
  </ItemGroup>
</Project>
