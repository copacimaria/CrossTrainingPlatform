@model CrossTrainingPlatform.Models.UserManagementModels.AppClaim

@Html.AntiForgeryToken()


<h1 style="margin-top: 5px">Sunteti sigur ca vreti sa stergeti acest claim?</h1>
<hr />

<dl class="row" style="text-align: left; margin-left: 0px; font-size:1rem;">
    <dt class="col-sm-6">
        Numele claim-ului:
    </dt>
    <dd class="col-sm-6">
        @Html.DisplayFor(model => model.ClaimName)
    </dd>

</dl>

<br />

<div class="d-flex justify-content-center">
    <button type="button"
            class="btn btn-danger"
            onclick="postDeleteClaim('@Model.ClaimId')" />
    Confirma stergerea
</div>