@model CrossTrainingPlatform.Models.UserManagementModels.AppRole
@Html.AntiForgeryToken()

<div class="row justify-content-center">
    <div class="col-sm-8">

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <!-- Hidden ID Field -->
        <input type="hidden" asp-for="RoleId" />

        <div class="form-group">

            <label for="RoleName" style="font-size: 25px;" class="control-labelEdit">Nume rol:</label>
            <input asp-for="RoleName" id="roleNameEdit" class="form-control" />
            <span asp-validation-for="RoleName" class="text-danger"></span>


        </div>


        <br />

        <div class="d-flex justify-content-center">
            <button type="button" onclick="saveEditRole('@Model.RoleId')" class="btn btn-success" />
            Salveaza
        </div>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
