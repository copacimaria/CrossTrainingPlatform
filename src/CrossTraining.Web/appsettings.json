{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },

  // Unde se pastreaza cheile care semneaza cookie-urile si token-urile. Gol: locatia
  // implicita a masinii. Pe mai multe instante sau intr-un container: un folder comun si
  // persistent, setat prin variabila DataProtection__KeysPath.
  "DataProtection": {
    "KeysPath": ""
  },

  // Adresele IP ale reverse proxy-urilor de incredere. Gol: aplicatia nu are proxy in fata
  // si nu citeste X-Forwarded-For. Prin mediu: ReverseProxy__KnownProxies__0=10.0.0.5
  "ReverseProxy": {
    "KnownProxies": []
  },

  "AllowedHosts": "*"
}
