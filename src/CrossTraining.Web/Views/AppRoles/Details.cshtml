@model RoleClaimsViewModel
@{
    ViewData["Title"] = "Drepturile rolului";
    var canManage = User.HasPermission(Permissions.Roles.Manage);
    var search = ViewBag.SelectedClaim as string;

    // Rolul Admin pastreaza drepturile de sistem (vezi RevokeClaimFromRoleHandler), deci
    // pentru ele nu se afiseaza butonul de eliminare.
    var isAdminRole = SystemRoles.IsAdmin(Model.Role.RoleName);
}

<!-- Modal adaugare drept -->
<div class="modal fade" id="addClaimModal" tabindex="-1" aria-labelledby="addClaimTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addClaimTitle"><i class="bi bi-key"></i> Adauga un drept</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Inchide"></button>
            </div>
            <div class="modal-body"></div>
        </div>
    </div>
</div>

<partial name="_AdminTabs" />

<a asp-action="Index" asp-controller="AppRoles" class="back-link"><i class="bi bi-arrow-left"></i> Toate rolurile</a>

<div class="page-head">
    <div>
        <span class="eyebrow"><i class="bi bi-person-badge-fill"></i> Rol</span>
        <h1>@Model.Role.RoleName</h1>
        <p>Drepturile acordate acestui rol. Fiecare utilizator cu rolul le primeste pe toate.</p>
    </div>
    @if (canManage)
    {
        <button type="button" class="btn btn-glow" data-modal="#addClaimModal"
                data-modal-url="@Url.Action("AddClaim", new { id = Model.Role.RoleId })">
            <i class="bi bi-plus-lg"></i> Adauga un drept
        </button>
    }
</div>

@if (!Model.Role.IsActive)
{
    <div class="notice notice--info">
        <i class="bi bi-info-circle-fill"></i> Rolul este dezactivat: drepturile lui nu se aplica pana la reactivare.
    </div>
}

<div class="panel">
    <form asp-action="Details" asp-route-id="@Model.Role.RoleId" method="get" class="toolbar" role="search">
        <div class="input-icon">
            <i class="bi bi-search"></i>
            <input type="search" id="claimSearchInRole" name="claimSearchInRole" class="input" placeholder="Cauta un drept"
                   aria-label="Cauta un drept in rol" value="@(search ?? "")" />
        </div>
        <button type="submit" class="btn btn-glass"><i class="bi bi-funnel"></i> Filtreaza</button>
        @if (!string.IsNullOrEmpty(search))
        {
            <a asp-action="Details" asp-route-id="@Model.Role.RoleId" class="btn btn-glass"><i class="bi bi-x-lg"></i> Reseteaza</a>
        }
    </form>

    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Drept</th>
                    <th class="text-end">Actiuni</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Claims == null || Model.Claims.Count == 0)
                {
                    <tr><td colspan="2" class="table-empty">Rolul nu are niciun drept@(string.IsNullOrEmpty(search) ? "" : " care sa corespunda cautarii").</td></tr>
                }
                else
                {
                    foreach (var item in Model.Claims)
                    {
                        <tr>
                            <td>@item.ClaimName</td>
                            <td class="cell-actions">
                                @if (canManage && !(isAdminRole && item.IsSystem))
                                {
                                    <form asp-action="RemoveClaim" method="post" class="d-inline"
                                          data-ajax-form data-toast="Dreptul a fost eliminat din rol!" data-toast-color="red">
                                        <input type="hidden" name="roleId" value="@Model.Role.RoleId" />
                                        <input type="hidden" name="claimId" value="@item.ClaimId" />
                                        <button type="submit" class="icon-btn icon-btn--danger" title="Elimina din rol"
                                                aria-label="Elimina @item.ClaimName din rol">
                                            <i class="bi bi-dash-circle"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/approles-details.js" asp-append-version="true"></script>
}
