@model RoleFormModel

<form asp-action="Edit" asp-route-id="@Model.RoleId" method="post"
      data-ajax-form data-toast="Rolul a fost editat!" data-toast-color="green">
    <div class="row justify-content-center">
        <div class="col-sm-8">
            <div class="alert alert-danger py-2" data-form-errors role="alert" hidden></div>

            <div class="form-group">
                <label asp-for="RoleName" class="control-label admin-form-label">Nume rol:</label>
                <input asp-for="RoleName" class="form-control" required />
            </div>

            <br />

            <div class="d-flex justify-content-center">
                <button type="submit" class="btn btn-success">Salveaza</button>
            </div>
        </div>
    </div>
</form>
