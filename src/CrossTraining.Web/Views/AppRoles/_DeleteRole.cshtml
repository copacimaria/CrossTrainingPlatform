@model RoleDto

<div class="confirm">
    <div class="confirm__icon"><i class="bi bi-trash3"></i></div>
    <h3>Stergi acest rol?</h3>
    <p>Rolul se dezactiveaza: utilizatorii lui pierd drepturile rolului, pana la o eventuala reactivare.</p>
    <span class="confirm__subject">@Model.RoleName</span>

    <form asp-action="DeleteConfirmed" asp-route-id="@Model.RoleId" method="post"
          data-ajax-form data-toast="Rolul a fost sters!" data-toast-color="red">
        <div class="notice notice--danger" data-form-errors role="alert" hidden></div>

        <div class="form-actions">
            <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Renunta</button>
            <button type="submit" class="btn btn-danger-glow"><i class="bi bi-trash3"></i> Sterge</button>
        </div>
    </form>
</div>
