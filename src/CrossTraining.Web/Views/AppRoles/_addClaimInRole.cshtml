@model RoleClaimsViewModel
@Html.AntiForgeryToken()

<div class="row justify-content-center">
    <div class="col-sm-8">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        @* Lista de claim-uri disponibile nu mai este trimisa in pagina si nici inapoi la
           server: autocomplete-ul o cere pe bucati, filtrata in baza de date. *@
        <input type="hidden" id="addClaimRoleId" value="@Model.Role.RoleId" />

        <div class="container mb-4 addclaim-role-line">
            <div class="row align-items-center">
                <div class="col-auto"><label class="fw-bold">Rolul:</label></div>
                <div class="col"><span>@Model.Role.RoleName</span></div>
            </div>
        </div>

        <div class="container mb-4">
            <label for="claimSearch" class="form-label fw-bold">Cauta drept:</label>
            <input type="text" id="claimSearch" class="form-control mb-2" placeholder="Cauta dupa nume"
                   autocomplete="off" onkeyup="searchClaim()" />
            <ul id="searchResults" class="dropdown-menu w-100 addclaim-results"></ul>
        </div>

        <input type="hidden" id="selectedClaimId" name="selectedClaimId" />

        <br />

        <div class="d-flex justify-content-center">
            <button type="button" onclick="addClaimFct('@Model.Role.RoleId')" class="btn btn-success">Salveaza</button>
        </div>
    </div>
</div>
