@model SelectDomainViewModel
@{
    ViewData["Title"] = "Select Domains";
}

<div class="page-wrapper">
    <div class="domain-container">
        <h2>Select Domains</h2>
        <p>Poti alege unul sau mai multe domenii.</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="form-errors">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form asp-controller="Domain" asp-action="SaveUserDomain" method="post">
            @* Token semnat, emis la register. Inlocuieste vechiul userId trimis in clar. *@
            <input type="hidden" asp-for="Token" />

            <div class="form-group">
                <div class="domain-checkbox-list">
                    @foreach (var domain in Model.Domains)
                    {
                        <label class="domain-checkbox-item">
                            <input type="checkbox" name="domainIds" value="@domain.DomainId" />
                            <span>@domain.DomainName</span>
                        </label>
                    }
                </div>
            </div>

            <button type="submit" class="submit-btn">Submit</button>
        </form>
    </div>
</div>
