@model DomainDto

<h1 class="delete-heading">Sunteti sigur ca vreti sa stergeti acest domeniu?</h1>
<hr />

<dl class="row admin-detail-list">
    <dt class="col-sm-4">Domeniul:</dt>
    <dd class="col-sm-8">@Model.DomainName</dd>
</dl>

<br />

<form asp-action="DeleteConfirmed" asp-route-id="@Model.DomainId" method="post"
      data-ajax-form data-toast="Domeniul a fost sters!" data-toast-color="red">
    <div class="alert alert-danger py-2" data-form-errors role="alert" hidden></div>

    <div class="d-flex justify-content-center">
        <button type="submit" class="btn btn-danger">Confirma stergerea</button>
    </div>
</form>
