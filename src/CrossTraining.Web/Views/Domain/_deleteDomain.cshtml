@model DomainDto
@{
    ViewData["Title"] = "Delete Domain";
}

<h2>Delete Domain</h2>

<p>Are you sure you want to delete this domain?</p>

<div>
    <strong>Name:</strong> @Model.DomainName <br />
    <strong>Active:</strong> @(Model.IsActive ? "Yes" : "No")
</div>

<form asp-action="Delete" asp-route-id="@Model.DomainId" method="post">
    <input type="hidden" asp-for="DomainId" />
    <button type="submit">Yes, Delete</button>
    <a asp-action="Index">Cancel</a>
</form>
