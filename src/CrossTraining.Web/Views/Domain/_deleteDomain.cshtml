@model DomainDto

<div class="confirm">
    <div class="confirm__icon"><i class="bi bi-trash3"></i></div>
    <h3>Stergi acest domeniu?</h3>
    <p>Domeniul se dezactiveaza: nu mai poate fi ales la inregistrare, dar se poate reactiva din editare.</p>
    <span class="confirm__subject">@Model.DomainName</span>

    <form asp-action="DeleteConfirmed" asp-route-id="@Model.DomainId" method="post"
          data-ajax-form data-toast="Domeniul a fost sters!" data-toast-color="red">
        <div class="notice notice--danger" data-form-errors role="alert" hidden></div>

        <div class="form-actions">
            <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Renunta</button>
            <button type="submit" class="btn btn-danger-glow"><i class="bi bi-trash3"></i> Sterge</button>
        </div>
    </form>
</div>
