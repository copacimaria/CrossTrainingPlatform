@model DomainFormModel

@* Campurile comune formularelor de creare si de editare. *@
<div class="notice notice--danger" data-form-errors role="alert" hidden></div>

<div class="field">
    <label asp-for="DomainName" class="field-label">Numele domeniului</label>
    <input asp-for="DomainName" class="input" placeholder="de exemplu: Medicina" required />
</div>

<div class="form-check">
    <input asp-for="IsActive" class="form-check-input" />
    <label asp-for="IsActive" class="form-check-label">Activ (poate fi ales la inregistrare)</label>
</div>
