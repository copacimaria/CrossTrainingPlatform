@model DomainFormModel

<form asp-action="Edit" asp-route-id="@Model.DomainId" method="post"
      data-ajax-form data-toast="Domeniul a fost editat!" data-toast-color="green">
    <partial name="_DomainFields" model="Model" />

    <div class="d-flex justify-content-center">
        <button type="submit" class="btn btn-success">Salveaza</button>
    </div>
</form>
