@model IPagedList<ClaimDto>
@{
    ViewData["Title"] = "Claim-uri";
}

<br /><br />

<!-- Modale -->
<div class="modal fade" id="createClaimModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog admin-modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Creare claim:</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="contentAddClaim"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="editClaimModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog admin-modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editeaza claim-ul:</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="contentEditClaim"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteClaimModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog admin-modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmare stergere claim</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="contentDeleteClaim"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="detailsClaimModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog admin-modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Detalii claim</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="contentDetailsClaim"></div>
        </div>
    </div>
</div>

@{
    // Butoanele urmeaza drepturile cerute de actiunile la care duc. Inainte, view-ul
    // cauta claim-uri cu nume vechi ("CreateClaim", "EditClaim"...) pe care sistemul de
    // drepturi nu le mai emite, deci un admin nou nu vedea niciun buton.
    var canManage = User.HasPermission(Permissions.Claims.Manage);
}

<div class="d-flex justify-content-between align-items-center admin-header">
    <h1 class="mb-0">Claim-uri</h1>
    @if (canManage)
    {
        <button type="button" data-modal-url="@Url.Action("Create")" data-modal="#createClaimModal"
                class="btn btn-dark fw-bold">
            <i class="bi bi-plus-circle me-2"></i> Creeaza un nou claim
        </button>
    }
</div>

<div class="col">
    <!-- Filtre -->
    <div class="d-flex mb-3">
        <form asp-action="Index" method="get" class="d-flex gap-3 admin-filter-form">
            <div>
                <label for="claimSearch" class="form-label mb-0 admin-filter-label">Cauta un claim:</label>
                <input type="text" id="claimSearch" name="claimSearch" placeholder="Cauta dupa nume"
                       class="form-control form-control-sm admin-filter-input"
                       value="@(ViewBag.SelectedClaim ?? "")" />
            </div>
            <button type="submit" class="btn btn-success mt-4 fw-bold">
                <i class="bi bi-search"></i> Filtreaza
            </button>
            <a asp-action="Index" class="btn btn-danger mt-4 fw-bold">
                <i class="bi bi-x-circle"></i> Reseteaza
            </a>
        </form>
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th class="fw-bold">Nume claim</th>
                <th class="fw-bold">Stare</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    <tr class="@(item.IsActive ? "" : "admin-row-inactive")">
                        <td>@item.ClaimName</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Activ</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Dezactivat</span>
                            }
                            @if (item.IsSystem)
                            {
                                <span class="badge bg-warning text-dark"
                                      title="Folosit de aplicatie: nu poate fi redenumit sau dezactivat">Sistem</span>
                            }
                        </td>
                        <td>
                            @* Fara onclick: atributele data-* le leaga admin.js (vezi comentariul
                               de la inceputul fisierului), iar CSP-ul interzice scripturile inline. *@
                            <button type="button" class="view-link" title="Detalii"
                                    data-modal-url="@Url.Action("Details", new { id = item.ClaimId })"
                                    data-modal="#detailsClaimModal">
                                <i class="bi bi-eye-fill"></i>
                            </button>
                            @if (canManage && !item.IsSystem)
                            {
                                <button type="button" class="edit-link" title="Editeaza"
                                        data-modal-url="@Url.Action("Edit", new { id = item.ClaimId })"
                                        data-modal="#editClaimModal">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                            }
                            @if (canManage && !item.IsSystem && item.IsActive)
                            {
                                <button type="button" class="delete-link" title="Sterge"
                                        data-modal-url="@Url.Action("Delete", new { id = item.ClaimId })"
                                        data-modal="#deleteClaimModal">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            }
                            @if (canManage && !item.IsActive)
                            {
                                <form asp-action="Reactivate" asp-route-id="@item.ClaimId" method="post" class="d-inline"
                                      data-ajax-form data-toast="Claim-ul a fost reactivat!" data-toast-color="green"
                                      data-confirm="@($"Reactivati claim-ul \"{item.ClaimName}\"? Rolurile care il aveau il primesc inapoi.")">
                                    <button type="submit" class="reactivate-link" title="Reactiveaza">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="pagination-container d-flex justify-content-center mb-5">
        @Html.PagedListPager(Model, page => Url.Action("Index", "AppClaims", new { page, claimSearch = ViewBag.SelectedClaim }))
    </div>
</div>
