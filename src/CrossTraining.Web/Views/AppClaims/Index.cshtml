@model IPagedList<ClaimDto>
@{
    ViewData["Title"] = "Drepturi";

    // Butoanele urmeaza drepturile cerute de actiunile la care duc. Inainte, view-ul
    // cauta claim-uri cu nume vechi ("CreateClaim", "EditClaim"...) pe care sistemul de
    // drepturi nu le mai emite, deci un admin nou nu vedea niciun buton.
    var canManage = User.HasPermission(Permissions.Claims.Manage);
    var search = ViewBag.SelectedClaim as string;
}

<!-- Modale -->
<div class="modal fade" id="createClaimModal" tabindex="-1" aria-labelledby="createClaimTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createClaimTitle"><i class="bi bi-plus-circle"></i> Drept nou</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Inchide"></button>
            </div>
            <div class="modal-body"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="editClaimModal" tabindex="-1" aria-labelledby="editClaimTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editClaimTitle"><i class="bi bi-pencil-square"></i> Redenumeste dreptul</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Inchide"></button>
            </div>
            <div class="modal-body"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteClaimModal" tabindex="-1" aria-labelledby="deleteClaimTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteClaimTitle"><i class="bi bi-trash3"></i> Stergere drept</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Inchide"></button>
            </div>
            <div class="modal-body"></div>
        </div>
    </div>
</div>

<div class="modal fade" id="detailsClaimModal" tabindex="-1" aria-labelledby="detailsClaimTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detailsClaimTitle"><i class="bi bi-info-circle"></i> Detalii drept</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Inchide"></button>
            </div>
            <div class="modal-body"></div>
        </div>
    </div>
</div>

<partial name="_AdminTabs" />

<div class="page-head">
    <div>
        <span class="eyebrow"><i class="bi bi-key-fill"></i> Administrare</span>
        <h1>Drepturi</h1>
        <p>
            Drepturile controleaza ce poate face fiecare rol. Cele marcate „Sistem” sunt folosite
            de aplicatie si nu pot fi redenumite sau dezactivate.
        </p>
    </div>
    @if (canManage)
    {
        <button type="button" class="btn btn-glow" data-modal-url="@Url.Action("Create")" data-modal="#createClaimModal">
            <i class="bi bi-plus-lg"></i> Drept nou
        </button>
    }
</div>

<div class="panel">
    <form asp-action="Index" method="get" class="toolbar" role="search">
        <div class="input-icon">
            <i class="bi bi-search"></i>
            <input type="search" id="claimSearch" name="claimSearch" class="input" placeholder="Cauta dupa nume"
                   aria-label="Cauta un drept" value="@(search ?? "")" />
        </div>
        <button type="submit" class="btn btn-glass"><i class="bi bi-funnel"></i> Filtreaza</button>
        @if (!string.IsNullOrEmpty(search))
        {
            <a asp-action="Index" class="btn btn-glass"><i class="bi bi-x-lg"></i> Reseteaza</a>
        }
    </form>

    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Nume</th>
                    <th>Stare</th>
                    <th class="text-end">Actiuni</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr><td colspan="3" class="table-empty">Niciun drept gasit.</td></tr>
                }
                else
                {
                    foreach (var item in Model)
                    {
                        <tr class="@(item.IsActive ? "" : "row-inactive")">
                            <td class="cell-name">@item.ClaimName</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="pill pill--success">Activ</span>
                                }
                                else
                                {
                                    <span class="pill pill--muted">Dezactivat</span>
                                }
                                @if (item.IsSystem)
                                {
                                    <span class="pill pill--warning"
                                          title="Folosit de aplicatie: nu poate fi redenumit sau dezactivat">Sistem</span>
                                }
                            </td>
                            <td class="cell-actions">
                                @* Fara onclick: atributele data-* le leaga admin.js (vezi comentariul
                                   de la inceputul fisierului), iar CSP-ul interzice scripturile inline. *@
                                <button type="button" class="icon-btn icon-btn--view" title="Rolurile care il au"
                                        aria-label="Detalii @item.ClaimName"
                                        data-modal-url="@Url.Action("Details", new { id = item.ClaimId })"
                                        data-modal="#detailsClaimModal">
                                    <i class="bi bi-eye"></i>
                                </button>
                                @if (canManage && !item.IsSystem)
                                {
                                    <button type="button" class="icon-btn icon-btn--edit" title="Redenumeste"
                                            aria-label="Redenumeste @item.ClaimName"
                                            data-modal-url="@Url.Action("Edit", new { id = item.ClaimId })"
                                            data-modal="#editClaimModal">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                }
                                @if (canManage && !item.IsSystem && item.IsActive)
                                {
                                    <button type="button" class="icon-btn icon-btn--danger" title="Sterge"
                                            aria-label="Sterge @item.ClaimName"
                                            data-modal-url="@Url.Action("Delete", new { id = item.ClaimId })"
                                            data-modal="#deleteClaimModal">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                }
                                @if (canManage && !item.IsActive)
                                {
                                    <form asp-action="Reactivate" asp-route-id="@item.ClaimId" method="post" class="d-inline"
                                          data-ajax-form data-toast="Dreptul a fost reactivat!" data-toast-color="green"
                                          data-confirm="@($"Reactivati dreptul \"{item.ClaimName}\"? Rolurile care il aveau il primesc inapoi.")">
                                        <button type="submit" class="icon-btn icon-btn--restore" title="Reactiveaza"
                                                aria-label="Reactiveaza @item.ClaimName">
                                            <i class="bi bi-arrow-counterclockwise"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model != null && Model.PageCount > 1)
    {
        <div class="pager">
            @Html.PagedListPager(Model, page => Url.Action("Index", "AppClaims", new { page, claimSearch = search }))
        </div>
    }
</div>
