@model ClaimFormModel

<form asp-action="Edit" asp-route-id="@Model.ClaimId" method="post"
      data-ajax-form data-toast="Dreptul a fost redenumit!" data-toast-color="green">
    <div class="notice notice--danger" data-form-errors role="alert" hidden></div>

    <div class="field">
        <label asp-for="ClaimName" class="field-label">Numele dreptului</label>
        <input asp-for="ClaimName" class="input" required />
    </div>

    <div class="form-actions">
        <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Renunta</button>
        <button type="submit" class="btn btn-glow"><i class="bi bi-check2"></i> Salveaza</button>
    </div>
</form>
