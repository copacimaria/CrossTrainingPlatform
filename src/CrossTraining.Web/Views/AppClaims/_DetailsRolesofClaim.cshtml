@model ClaimWithRolesDto

<dl class="kv">
    <div>
        <dt>Dreptul</dt>
        <dd><span class="confirm__subject mb-0">@Model.ClaimName</span></dd>
    </div>

    <div>
        <dt>Rolurile care il au</dt>
        <dd class="mt-2">
            @if (Model.RoleNames.Count > 0)
            {
                <div class="chips">
                    @foreach (var roleName in Model.RoleNames)
                    {
                        <span class="tag"><i class="bi bi-person-badge"></i> @roleName</span>
                    }
                </div>
            }
            else
            {
                <span class="text-soft">Niciun rol nu are acest drept.</span>
            }
        </dd>
    </div>
</dl>
