@model ClaimWithRolesDto

<div class="confirm">
    <div class="confirm__icon"><i class="bi bi-trash3"></i></div>
    <h3>Stergi acest drept?</h3>
    <p>Dreptul se dezactiveaza: rolurile care il au il pierd, pana la o eventuala reactivare.</p>
    <span class="confirm__subject">@Model.ClaimName</span>

    <form asp-action="DeleteConfirmed" asp-route-id="@Model.ClaimId" method="post"
          data-ajax-form data-toast="Dreptul a fost sters!" data-toast-color="red">
        <div class="notice notice--danger" data-form-errors role="alert" hidden></div>

        <div class="form-actions">
            <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Renunta</button>
            <button type="submit" class="btn btn-danger-glow"><i class="bi bi-trash3"></i> Sterge</button>
        </div>
    </form>
</div>
