@model ClaimWithRolesDto

<h1 class="delete-heading">Sunteti sigur ca vreti sa stergeti acest claim?</h1>
<hr />

<dl class="row admin-detail-list">
    <dt class="col-sm-6">Numele claim-ului:</dt>
    <dd class="col-sm-6">@Model.ClaimName</dd>
</dl>

<br />

<form asp-action="DeleteConfirmed" asp-route-id="@Model.ClaimId" method="post"
      data-ajax-form data-toast="Claim-ul a fost sters!" data-toast-color="red">
    <div class="alert alert-danger py-2" data-form-errors role="alert" hidden></div>

    <div class="d-flex justify-content-center">
        <button type="submit" class="btn btn-danger">Confirma stergerea</button>
    </div>
</form>
