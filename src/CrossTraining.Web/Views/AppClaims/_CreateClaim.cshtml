@model ClaimFormModel

@* Trimis de admin.js (data-ajax-form). Tag helper-ul <form> pune si token-ul antiforgery. *@
<form asp-action="Create" method="post" data-ajax-form data-toast="Dreptul a fost creat!" data-toast-color="grey">
    <div class="notice notice--danger" data-form-errors role="alert" hidden></div>

    <div class="field">
        <label asp-for="ClaimName" class="field-label">Numele dreptului</label>
        <input asp-for="ClaimName" class="input" placeholder="de exemplu: rapoarte.view" required />
    </div>

    <div class="form-actions">
        <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Renunta</button>
        <button type="submit" class="btn btn-glow"><i class="bi bi-plus-lg"></i> Adauga</button>
    </div>
</form>
