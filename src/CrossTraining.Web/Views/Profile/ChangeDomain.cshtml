@model ChangeDomainViewModel
@{
    ViewData["Title"] = "Domeniile mele";
}

<section class="auth">
    <div class="auth__grid auth__grid--single">
        <div class="panel panel--glow panel__body auth-card">
            <a class="back-link" asp-controller="Profile" asp-action="Index"><i class="bi bi-arrow-left"></i> Inapoi la profil</a>
            <h2>Domeniile mele</h2>
            <p class="auth-card__sub">
                Alege domeniile care te intereseaza. Catalogul isi ordoneaza recomandarile dupa ele.
            </p>

            <partial name="_FormErrors" />

            <form asp-controller="Profile" asp-action="ChangeDomain" method="post">
                <div class="choice-grid">
                    @foreach (var d in Model.AvailableDomains)
                    {
                        <label class="choice">
                            <input type="checkbox" class="choice__input" name="SelectedDomainIds" value="@d.DomainId"
                                   checked="@(Model.SelectedDomainIds.Contains(d.DomainId))" />
                            <span class="choice__body">@d.DomainName</span>
                        </label>
                    }
                </div>

                <div class="form-actions">
                    <a class="btn btn-glass" asp-controller="Profile" asp-action="Index">Renunta</a>
                    <button type="submit" class="btn btn-glow"><i class="bi bi-check2"></i> Salveaza</button>
                </div>
            </form>
        </div>
    </div>
</section>
