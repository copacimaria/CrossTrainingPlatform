@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Schimbare parola";
}

<div class="page-wrapper">
    <div class="auth-card">
        <h2 class="auth-title">Change Password</h2>

        @if (ViewBag.Success != null)
        {
            <div class="auth-success">@ViewBag.Success</div>
            <div class="auth-back-link">
                <a asp-controller="Profile" asp-action="Index">Inapoi la profil</a>
            </div>
        }

        <form asp-controller="Profile" asp-action="ChangePassword" method="post">
            <div class="form-group">
                <label>Old Password</label>
                <input asp-for="OldPassword" type="password" class="form-control auth-input" />
                <span asp-validation-for="OldPassword" class="field-error"></span>
            </div>

            <div class="form-group">
                <label>New Password</label>
                <input asp-for="NewPassword" type="password" class="form-control auth-input" />
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>

            <button type="submit" class="login-btn auth-submit">Save</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
