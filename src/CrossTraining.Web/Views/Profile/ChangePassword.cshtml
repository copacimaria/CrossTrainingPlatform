@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Schimba parola";
}

<section class="auth">
    <div class="auth__grid auth__grid--single auth__grid--narrow">
        <div class="panel panel--glow panel__body auth-card">
            <a class="back-link" asp-controller="Profile" asp-action="Index"><i class="bi bi-arrow-left"></i> Inapoi la profil</a>
            <h2>Schimba parola</h2>
            <p class="auth-card__sub">Noua parola trebuie sa aiba minim 6 caractere.</p>

            @if (ViewBag.Success != null)
            {
                <div class="notice notice--success" role="status">
                    <i class="bi bi-check-circle-fill"></i> @ViewBag.Success
                </div>
            }

            <partial name="_FormErrors" />

            <form asp-controller="Profile" asp-action="ChangePassword" method="post">
                <div class="field">
                    <label asp-for="OldPassword" class="field-label">Parola actuala</label>
                    <div class="input-icon">
                        <i class="bi bi-lock"></i>
                        <input asp-for="OldPassword" type="password" class="input" autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="OldPassword"></span>
                </div>

                <div class="field">
                    <label asp-for="NewPassword" class="field-label">Parola noua</label>
                    <div class="input-icon">
                        <i class="bi bi-shield-lock"></i>
                        <input asp-for="NewPassword" type="password" class="input" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="NewPassword"></span>
                </div>

                <button type="submit" class="btn btn-glow btn-lg btn-block mt-2">
                    <i class="bi bi-check2"></i> Salveaza parola
                </button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
