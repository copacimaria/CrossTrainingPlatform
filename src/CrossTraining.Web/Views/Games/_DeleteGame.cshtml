@model GameDto

<div class="confirm">
    <div class="confirm__icon"><i class="bi bi-trash3"></i></div>
    <h3>Stergi aplicatia din catalog?</h3>
    <p>Aplicatia nu va mai aparea in catalog pentru niciun utilizator.</p>
    <span class="confirm__subject">@Model.GameName</span>

    <form asp-action="PostDelete" method="post" data-ajax-form data-toast="Aplicatia a fost stearsa!" data-toast-color="red">
        <input type="hidden" name="gameId" value="@Model.GameId" />
        <div class="notice notice--danger" data-form-errors role="alert" hidden></div>

        <div class="form-actions">
            <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Renunta</button>
            <button type="submit" class="btn btn-danger-glow"><i class="bi bi-trash3"></i> Sterge</button>
        </div>
    </form>
</div>
