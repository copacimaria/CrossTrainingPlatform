@model GameDto

<div class="delete-modal-container">
    <h3 class="delete-title">Confirmare stergere</h3>

    <p class="delete-warning">Esti sigur ca vrei sa stergi acest joc?</p>

    <div class="delete-summary">
        <p><strong>Nume joc:</strong> @Model.GameName</p>
    </div>

    <br />

    <form asp-action="PostDelete" method="post" data-ajax-form data-toast="The game was removed!" data-toast-color="red">
        <input type="hidden" name="gameId" value="@Model.GameId" />
        <div class="alert alert-danger py-2" data-form-errors role="alert" hidden></div>

        <div class="d-flex justify-content-center">
            <button type="submit" class="btn btn-danger">Confirma stergerea</button>
        </div>
    </form>
</div>
