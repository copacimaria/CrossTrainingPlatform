@model GameFormModel

@* Trimis de admin.js (data-ajax-form). Tag helper-ul <form> pune si token-ul antiforgery. *@
<form asp-action="Create" method="post" data-ajax-form data-toast="The game was added!" data-toast-color="grey">
    <div class="row justify-content-center">
        <div class="col-sm-8">
            <div class="alert alert-danger py-2" data-form-errors role="alert" hidden></div>

            <div class="modal-form-group mb-3">
                <label asp-for="GameName" class="control-label fw-bold game-form-label">Nume joc:</label>
                <input asp-for="GameName" class="form-control" required />
            </div>

            <div class="modal-form-group mb-3">
                <label asp-for="DomainId" class="control-label fw-bold game-form-label">Domain:</label>
                <select asp-for="DomainId" class="form-control" asp-items="ViewBag.Domains" required>
                    <option value="">-- Selecteaza domeniul --</option>
                </select>
            </div>

            <div class="modal-form-group">
                <label asp-for="Description">Descriere:</label>
                <textarea asp-for="Description" maxlength="300" rows="3" required data-autosize></textarea>
            </div>

            <div class="modal-form-group mb-3">
                <label asp-for="DownloadLink" class="control-label fw-bold game-form-label">Link de descarcare:</label>
                <input asp-for="DownloadLink" class="form-control" />
            </div>

            <br />

            <div class="d-flex justify-content-center">
                <button type="submit" class="btn btn-success">Adauga</button>
            </div>
        </div>
    </div>
</form>
