@model CrossTraining.Domain.Entities.Game
@Html.AntiForgeryToken()

<div class="row justify-content-center">
    <div class="col-sm-8">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="modal-form-group mb-3">
            <label asp-for="GameName" class="control-label fw-bold game-form-label">Nume joc:</label>
            <input asp-for="GameName" id="gameNameCreate" class="form-control" />
        </div>

        <div class="modal-form-group mb-3">
            <label asp-for="DomainId" class="control-label fw-bold game-form-label">Domain:</label>
            <select asp-for="DomainId" class="form-control" id="domainCreate" asp-items="ViewBag.Domains">
                <option value="">-- Selecteaza domeniul --</option>
            </select>
        </div>

        <div class="modal-form-group">
            <label asp-for="Description">Descriere:</label>
            <textarea asp-for="Description" id="descriptionCreate" maxlength="300" rows="3"></textarea>
        </div>

        <div class="modal-form-group mb-3">
            <label asp-for="DownloadLink" class="control-label fw-bold game-form-label">Link de descarcare:</label>
            <input asp-for="DownloadLink" id="linkCreate" class="form-control" />
        </div>

        <br />

        <div class="d-flex justify-content-center">
            <button type="button" onclick="createGame()" class="btn btn-success">Adauga</button>
        </div>
    </div>
</div>
