@model GameFormModel

<form asp-action="Edit" asp-route-id="@Model.GameId" method="post"
      data-ajax-form data-toast="Aplicatia a fost actualizata!" data-toast-color="green">
    <partial name="_GameFields" model="Model" />

    <div class="form-actions">
        <button type="button" class="btn btn-glass" data-bs-dismiss="modal">Renunta</button>
        <button type="submit" class="btn btn-glow"><i class="bi bi-check2"></i> Salveaza</button>
    </div>
</form>
