@model CrossTraining.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = "Eroare";
}

<section class="status-page status-page--danger">
    <div class="icon-tile"><i class="bi bi-exclamation-triangle-fill"></i></div>
    <span class="status-page__code">500</span>
    <h1 class="h3 mt-3">Ceva nu a mers bine</h1>
    <p class="text-soft">
        Cererea ta nu a putut fi procesata. Incearca din nou peste cateva momente; daca problema
        persista, trimite codul de mai jos echipei de suport.
    </p>

    @if (Model.ShowRequestId)
    {
        <p class="confirm__subject">Codul cererii (Request ID): @Model.RequestId</p>
    }

    <div class="hero__actions justify-content-center">
        <a class="btn btn-glass" href="@Url.Action("Index", "Home")"><i class="bi bi-house"></i> Pagina principala</a>
    </div>
</section>
