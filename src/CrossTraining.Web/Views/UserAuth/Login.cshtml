@model LoginViewModel
@{
    ViewData["Title"] = "Autentificare";
}

<section class="auth">
    <div class="auth__grid">
        <div class="auth__pitch">
            <span class="eyebrow"><i class="bi bi-door-open-fill"></i> Bine ai revenit</span>
            <h1 class="display">Continua de unde ai <span class="text-gradient">ramas</span>.</h1>
            <p class="lead-x">Aplicatiile recomandate pentru domeniile tale te asteapta in catalog.</p>

            <ul class="benefits">
                <li>
                    <span class="icon-tile"><i class="bi bi-grid-1x2-fill"></i></span>
                    <div><strong>Catalogul tau</strong><span>Jocuri si simulari alese pentru ce studiezi.</span></div>
                </li>
                <li>
                    <span class="icon-tile"><i class="bi bi-diagram-3-fill"></i></span>
                    <div><strong>Domenii flexibile</strong><span>Schimbi oricand domeniile din profil.</span></div>
                </li>
                <li>
                    <span class="icon-tile"><i class="bi bi-shield-lock-fill"></i></span>
                    <div><strong>Cont protejat</strong><span>Parola nu este pastrata niciodata in clar.</span></div>
                </li>
            </ul>
        </div>

        <div class="panel panel--glow panel__body auth-card">
            <h2>Autentificare</h2>
            <p class="auth-card__sub">Intra in contul tau CrossTraining.</p>

            <partial name="_FormErrors" />

            <form asp-controller="UserAuth" asp-action="Login" method="post">
                <div class="field">
                    <label asp-for="Email" class="field-label">Email</label>
                    <div class="input-icon">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Email" class="input" placeholder="nume@exemplu.ro" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email"></span>
                </div>

                <div class="field">
                    <label asp-for="Password" class="field-label">Parola</label>
                    <div class="input-icon">
                        <i class="bi bi-lock"></i>
                        <input asp-for="Password" type="password" class="input" placeholder="Parola ta" autocomplete="current-password" />
                    </div>
                    <span asp-validation-for="Password"></span>
                </div>

                <button type="submit" class="btn btn-glow btn-lg btn-block mt-2">
                    Intra in cont <i class="bi bi-arrow-right"></i>
                </button>
            </form>

            <p class="auth-alt">
                Nu ai cont?
                <a asp-controller="UserAuth" asp-action="Register">Creeaza unul acum</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
