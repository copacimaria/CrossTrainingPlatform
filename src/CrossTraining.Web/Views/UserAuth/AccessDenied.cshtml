@{
    ViewData["Title"] = "Acces interzis";
    var returnUrl = ViewBag.ReturnUrl as string;
}

<section class="status-page">
    <div class="icon-tile"><i class="bi bi-shield-lock-fill"></i></div>
    <span class="status-page__code">403</span>
    <h1 class="h3 mt-3">Acces interzis</h1>
    <p class="text-soft">Contul tau nu are dreptul necesar pentru pagina ceruta.</p>

    @if (!string.IsNullOrEmpty(returnUrl))
    {
        <p class="text-soft">Pagina: <code>@returnUrl</code></p>
    }

    <div class="hero__actions justify-content-center">
        <a class="btn btn-glow" href="@Url.Action("DisplayGamesBasedOnDomain", "Games")">
            <i class="bi bi-grid-1x2-fill"></i> Inapoi la catalog
        </a>
    </div>
</section>
