@model RegisterViewModel
@{
    ViewData["Title"] = "Creeaza cont";
}

<section class="auth">
    <div class="auth__grid">
        <div class="auth__pitch">
            <span class="eyebrow"><i class="bi bi-rocket-takeoff-fill"></i> Cont nou</span>
            <h1 class="display">Invatarea viitorului incepe <span class="text-gradient">aici</span>.</h1>
            <p class="lead-x">Iti creezi contul, alegi domeniile si primesti aplicatiile potrivite pentru tine.</p>

            <ul class="benefits">
                <li>
                    <span class="icon-tile"><i class="bi bi-1-circle-fill"></i></span>
                    <div><strong>Datele contului</strong><span>Nume, email si o parola de minim 6 caractere.</span></div>
                </li>
                <li>
                    <span class="icon-tile"><i class="bi bi-2-circle-fill"></i></span>
                    <div><strong>Domeniile tale</strong><span>Alegi unul sau mai multe domenii de interes.</span></div>
                </li>
                <li>
                    <span class="icon-tile"><i class="bi bi-3-circle-fill"></i></span>
                    <div><strong>Catalogul</strong><span>Aplicatiile recomandate apar primele.</span></div>
                </li>
            </ul>
        </div>

        <div class="panel panel--glow panel__body auth-card">
            <h2>Creeaza cont</h2>
            <p class="auth-card__sub">Pasul 1 din 2: datele contului.</p>

            <partial name="_FormErrors" />

            <form asp-controller="UserAuth" asp-action="Register" method="post">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <div class="field mb-0">
                            <label asp-for="Name" class="field-label">Prenume</label>
                            <input asp-for="Name" class="input" autocomplete="given-name" />
                            <span asp-validation-for="Name"></span>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="field mb-0">
                            <label asp-for="FamilyName" class="field-label">Nume</label>
                            <input asp-for="FamilyName" class="input" autocomplete="family-name" />
                            <span asp-validation-for="FamilyName"></span>
                        </div>
                    </div>
                </div>

                <div class="field mt-3">
                    <label asp-for="Email" class="field-label">Email</label>
                    <div class="input-icon">
                        <i class="bi bi-envelope"></i>
                        <input asp-for="Email" class="input" placeholder="nume@exemplu.ro" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email"></span>
                </div>

                <div class="field">
                    <label asp-for="Password" class="field-label">Parola</label>
                    <div class="input-icon">
                        <i class="bi bi-lock"></i>
                        <input asp-for="Password" type="password" class="input" placeholder="Minim 6 caractere" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="Password"></span>
                </div>

                <button type="submit" class="btn btn-glow btn-lg btn-block mt-2">
                    Continua <i class="bi bi-arrow-right"></i>
                </button>
            </form>

            <p class="auth-alt">
                Ai deja cont?
                <a asp-controller="UserAuth" asp-action="Login">Autentifica-te</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
